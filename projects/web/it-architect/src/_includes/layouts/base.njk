<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} | {{ site.name }}</title>
  <meta name="description" content="{{ description }}" />
  <meta name="theme-color" content="#1c2430" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

  {# Theme must be resolved BEFORE first paint. Inline and blocking on purpose:
     from an external file this runs after the stylesheet has already painted,
     and a dark-mode visitor gets a white flash on every navigation. #}
  <script>
    (function () {
      try {
        var saved = localStorage.getItem("theme");
        var dark = saved
          ? saved === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (dark) document.documentElement.setAttribute("data-theme", "dark");
      } catch (e) {
        /* Storage blocked (private mode). Light is a safe default. */
      }
    })();
  </script>

  {# Favicons. The monitor mark from the logo, white on a slate tile — the tile
     supplies its own background so the icon holds up on both light and dark
     browser tab strips. The full logo mark (tower + monitor) is unreadable at
     16px, which is why only the monitor is used here. #}
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&display=swap" rel="stylesheet" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "{{ site.name }}",
    "description": "Infrastructure, security and AI automation consultancy.",
    "url": "{{ site.url }}",
    "email": "{{ site.email }}",
    "telephone": "{{ site.phoneLink }}",
    "legalName": "{{ site.legalName }}",
    "areaServed": "GB",
    "founder": { "@type": "Person", "name": "{{ site.principal }}", "jobTitle": "{{ site.role }}" }
  }
  </script>

  <link rel="stylesheet" href="/assets/styles.css?v={{ assetHash }}" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>

  {% include "partials/header.njk" %}

  <main id="main">
    {% if not hidePageTitle %}
    <div class="page-head">
      <div class="container">
        {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
        <h1>{{ heading or title }}</h1>
        {% if standfirst %}<p class="standfirst">{{ standfirst }}</p>{% endif %}
      </div>
    </div>
    {% endif %}

    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script>
    // Mobile menu. Without JS the nav simply stays visible.
    (function () {
      var btn = document.querySelector('.menu-toggle');
      var nav = document.getElementById('main-nav');
      if (!btn || !nav) return;
      btn.hidden = false;
      nav.classList.add('is-collapsible');
      btn.addEventListener('click', function () {
        var open = nav.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.textContent = open ? 'Close' : 'Menu';
      });
    })();

    // Theme toggle. Revealed only with JS — a control that cannot work should
    // not be shown at all.
    (function () {
      var btn = document.querySelector('.theme-toggle');
      if (!btn) return;
      var root = document.documentElement;
      var meta = document.querySelector('meta[name="theme-color"]');
      var LIGHT = '#1c2430', DARK = '#0f141b';

      function sync() {
        var dark = root.getAttribute('data-theme') === 'dark';
        btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
        if (meta) meta.setAttribute('content', dark ? DARK : LIGHT);
      }

      btn.hidden = false;
      sync();

      btn.addEventListener('click', function () {
        var dark = root.getAttribute('data-theme') === 'dark';
        if (dark) root.removeAttribute('data-theme');
        else root.setAttribute('data-theme', 'dark');
        try { localStorage.setItem('theme', dark ? 'light' : 'dark'); } catch (e) {}
        sync();
      });

      // Follow the OS only while the visitor has expressed no preference.
      try {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
          if (localStorage.getItem('theme')) return;
          if (e.matches) root.setAttribute('data-theme', 'dark');
          else root.removeAttribute('data-theme');
          sync();
        });
      } catch (e) {}
    })();
  </script>
</body>
</html>
