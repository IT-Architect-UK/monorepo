layout: layouts/base.njk
title: Booking confirmed
heading: Your session is booked
standfirst: Just one thing left — the £5 booking fee.
description: Your IT Surgery session is confirmed. Pay the £5 booking fee to secure your slot.
eleventyExcludeFromCollections: true
noindex: true
bodyClass: page-booked
---

{# Reached only by the redirect from /book/ after Cal.com confirms a booking.
   The payment link is created by a background flow a second or two after the
   booking lands, so this page polls for it rather than assuming it exists.

   noindex: the page is meaningless without a booking id, and we do not want it
   in search results. #}

<section class="section">
  <div class="container narrow">

    {# aria-live so a screen reader hears the state change without the focus
       being yanked around. #}
    <p id="pay-status" class="lead" aria-live="polite">
      Preparing your secure payment page…
    </p>

    <div id="pay-action" hidden>
      <p class="pay-message">
        Taking you to our secure payment page in
        <span id="countdown">5</span> seconds…
      </p>

      {# Decorative: the countdown text above already carries the meaning. #}
      <div class="progress" aria-hidden="true"><div class="progress-bar" id="progress-bar"></div></div>

      <p>
        <a class="btn btn-primary" id="pay-link" href="#">Pay £{{ site.bookingFee }} now</a>
      </p>
      <p class="pay-note">
        The payment page is run by Xero, our accounting provider. You can pay by
        card, Apple Pay or Google Pay.
      </p>
    </div>

    <p id="pay-fallback" hidden>
      We've emailed your invoice — it has a Pay Now button. If it hasn't arrived
      in a few minutes, check your junk folder or
      <a href="tel:{{ site.phoneLink }}">call us on {{ site.phoneDisplay }}</a>
      and we'll sort it out.
    </p>

    <div class="cta-panel" id="confirmed">
      <h2>Confirmed<span id="when-wrap">, <span id="when"></span></span></h2>
      <p>
        We've emailed you a calendar invitation. Accept it and the appointment
        will appear in your diary.
      </p>
    </div>

    <p>
      It isn't an extra charge — it comes off your first hour, and you get it
      back in full if we can't fix the problem. Payment is handled by Stripe;
      we never see your card details. Our
      <a href="/booking-terms/">booking terms</a> set out the details.
    </p>

    <h2>What happens next</h2>
    <ol class="ticks wide">
      <li>You'll get a calendar invitation by email — accept it to save the time</li>
      <li>We'll join the call at the agreed time and connect to your computer</li>
      <li>The £{{ site.bookingFee }} comes off whatever the work costs</li>
    </ol>

    <div class="cta-panel">
      <h2>Need to change something?</h2>
      <p>
        Your confirmation email has links to reschedule or cancel. Or
        <a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">message us on WhatsApp<span class="visually-hidden"> (opens in a new tab)</span></a>
        and we'll do it for you.
      </p>
    </div>

    <h2>While you're here</h2>
    <ul class="ticks wide">
      <li><a href="/fixed-prices/">Fixed prices</a> — common jobs at a set price</li>
      <li><a href="/support-plans/">Support plans</a> — ongoing cover from £{{ site.plans.home.intro }} a month</li>
      <li><a href="/business-it/">Business IT</a> — if you also run a business</li>
    </ul>

  </div>
</section>

<script>
(function () {
  var params = new URLSearchParams(location.search);
  var uid = params.get('uid');
  var start = params.get('t');

  // Show the appointment time immediately if the booking page passed it, so the
  // customer sees confirmation before anything about money.
  if (start) {
    var d = new Date(start);
    if (!isNaN(d)) {
      document.getElementById('when').textContent = d.toLocaleString('en-GB', {
        weekday: 'long', day: 'numeric', month: 'long',
        hour: '2-digit', minute: '2-digit'
      });
    } else {
      document.getElementById('when-wrap').hidden = true;
    }
  } else {
    document.getElementById('when-wrap').hidden = true;
  }

  var status = document.getElementById('pay-status');
  var action = document.getElementById('pay-action');
  var link = document.getElementById('pay-link');
  var fallback = document.getElementById('pay-fallback');

  /* Five seconds is long enough to read where you are going and short enough
     not to feel stuck. The bar and the number say the same thing two ways —
     some people read numbers, some just want to see something moving. */
  function startRedirect(url) {
    var seconds = 5;
    var counter = document.getElementById('countdown');
    var bar = document.getElementById('progress-bar');
    counter.textContent = seconds;
    // next frame, so the transition actually runs
    requestAnimationFrame(function () {
      bar.style.transitionDuration = seconds + 's';
      bar.style.width = '100%';
    });
    var tick = setInterval(function () {
      seconds--;
      counter.textContent = seconds > 0 ? seconds : 0;
      if (seconds <= 0) {
        clearInterval(tick);
        window.location.href = url;
      }
    }, 1000);
  }

  function giveUp() {
    status.hidden = true;
    fallback.hidden = false;
  }

  if (!uid) { giveUp(); return; }

  var endpoint = {{ site.payLinkEndpoint | dump | safe }};
  var attempts = 0;

  function poll() {
    attempts++;
    fetch(endpoint + '&uid=' + encodeURIComponent(uid))
      .then(function (r) { return r.json(); })
      .then(function (j) {
        if (j && j.payUrl) {
          link.href = j.payUrl;
          status.hidden = true;
          action.hidden = false;
          /* Send them on automatically, but only after the confirmation and a
             plain statement of where they are going. An unannounced jump to a
             third-party domain is where a cautious customer closes the tab.
             The button is there for anyone who does not want to wait. */
          startRedirect(j.payUrl);
          return;
        }
        if (attempts >= 15) { giveUp(); return; }   // ~30 seconds
        setTimeout(poll, 2000);
      })
      .catch(function () {
        if (attempts >= 15) { giveUp(); return; }
        setTimeout(poll, 2000);
      });
  }

  poll();
})();
</script>
