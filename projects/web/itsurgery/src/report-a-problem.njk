{# The site is new, and the people who find its bugs are the people using it.
   Kept deliberately tiny: one box that matters, everything else optional. The
   page URL and browser are captured automatically so the reporter never has
   to answer "what browser are you on". Netlify Forms carries it — same
   machinery as the quote form, no new moving parts. #}
<section class="section">
  <div class="container narrow">

    {# Same components as the quote form — form-wrap, field, optional, btn,
       form-note. Written from scratch the first time and it looked it:
       browser-default inputs and a monospace textarea on a site that uses
       neither. #}
    <div class="form-wrap">
      <h2>What went wrong?</h2>

      <form name="site-issue" method="POST" action="/thanks/" data-netlify="true" data-netlify-honeypot="bot-field">
        <p class="hidden-field" aria-hidden="true">
          <label>Don't fill this in if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="field">
          <label for="what">Tell us what happened</label>
          <textarea id="what" name="what" rows="5" required
            placeholder="A sentence is plenty — for example: the Book button on the health check row did nothing on my phone."></textarea>
        </div>

        <div class="field">
          <label for="page">Which page? <span class="optional">(filled in for you if we can tell)</span></label>
          <input id="page" name="page" type="text" placeholder="e.g. the fixed prices page" />
        </div>

        <div class="field">
          <label for="email">Your email <span class="optional">(optional — only if you would like to hear it is fixed)</span></label>
          <input id="email" name="email" type="email" autocomplete="email" />
        </div>

        {# Captured quietly so nobody is ever asked what a browser version is. #}
        <input type="hidden" name="browser" id="browser" />

        <button class="btn btn-primary" type="submit">Send it</button>
        <p class="form-note">
          We will only use your email to reply about this problem — nothing
          else. Thank you for helping make the site better.
        </p>
      </form>
    </div>

  </div>
</section>

<script>
  (function () {
    var b = document.getElementById('browser');
    if (b) { b.value = navigator.userAgent; }
    var p = document.getElementById('page');
    if (p && document.referrer && document.referrer.indexOf('itsurgery.me') !== -1) {
      p.value = document.referrer;
    }
  })();
</script>
