---
# One template generates every service page from src/_data/services.json,
# so the 15 service pages share a single layout and cannot drift apart.
layout: layouts/base.njk
pagination:
  data: services
  size: 1
  alias: service
  # Without this Eleventy only puts the FIRST paginated page into
  # collections.all, so 14 of the 15 service pages were missing from
  # sitemap.xml.
  addAllPagesToCollections: true
permalink: "/{{ service.slug }}/"
eleventyComputed:
  # `| safe` prevents double-escaping: this front matter is itself rendered as a
  # template, so an unescaped "&" would become "&amp;" here and "&amp;amp;" when
  # the layout outputs it. Escaping happens once, at output.
  title: "{{ service.title | safe }}"
  heading: "{{ service.title | safe }}"
  standfirst: "{{ service.summary | safe }}"
  description: "{{ service.title | safe }} from IT Surgery — {{ service.summary | safe }} Serving Penarth, Barry and Cardiff."
---

<section class="section">
  <div class="container">
    <div class="service-body">
      <p class="lead">{{ service.intro }}</p>
      <p>{{ service.body }}</p>

      <h2>What this covers</h2>
      <ul class="ticks wide">
        {% for p in service.points %}<li>{{ p }}</li>{% endfor %}
      </ul>

      {# Fixed prices for the jobs this service most often turns into, pulled
         from the catalogue by slug so a price change there shows here too.
         Services with no fixed-price jobs get the quote box below instead. #}
      {% if service.fixedPrices %}
      <div class="service-prices">
        <h2>Fixed prices for this</h2>
        <p>
          {% if service.group == "business" %}
          Set prices for the common jobs, {{ site.vatExLabel }}. Anything not listed is quoted or charged at £{{ site.businessHourlyRate }} an hour.
          {% else %}
          Set prices for the common jobs, {{ site.vatIncLabel }}, so you know the cost before we start. Anything not listed is £{{ site.hourlyRate }} an hour.
          {% endif %}
        </p>
        <ul class="band-list">
          {% for slug in service.fixedPrices %}
            {% set svc = catbyslug[slug] %}
            {% if svc %}
            <li>
              <span class="item-price">£{{ svc.priceIncVat or svc.priceExVat }}</span>
              <span class="item-meta">{{ svc.durationMinutes | duration }}</span>
              <span class="item-label">{{ svc.name }}{% if svc.unit %} <span class="addon">({{ svc.unit }})</span>{% endif %}</span>
              {% if svc.bookable and not svc.existing %}
              <a class="item-book" href="/book/?service={{ svc.slug }}">Book</a>
              {% endif %}
            </li>
            {% endif %}
          {% endfor %}
        </ul>
        <p class="service-prices-more">
          <a href="{{ '/business-fixed-prices/' if service.group == 'business' else '/fixed-prices/' }}">See the full {{ "business" if service.group == "business" else "home" }} price list</a>
        </p>
      </div>
      {% else %}
      {# Quoted work. No prices to show, so the same slot carries the route to
         a price instead: a button to the quote form, per Darren, 2026-09-05. #}
      <div class="service-prices">
        <h2>Priced for your job</h2>
        <p>
          This kind of work varies too much for a set price, so we quote it.
          Tell us what you need and we will come back with a clear price, or
          phone you to talk it through first.
        </p>
        <a class="btn btn-primary" href="/quote/">Get a quote</a>
      </div>
      {% endif %}

      <div class="cta-panel">
        <h2>Talk to us about {{ service.title }}</h2>
        <p>
          <a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">Message us on WhatsApp<span class="visually-hidden"> (opens in a new tab)</span></a>
          or <a href="/quote/">request a quote</a>.
          {# Services can override the standard hourly line — project work is
             quoted rather than charged by the hour. #}
          {% if service.rateNote %}
            {{ service.rateNote }}
          {% elif service.group == "business" %}
            Business support is £{{ site.businessHourlyRate }} an hour {{ site.vatExLabel }}, or from
            £{{ site.plans.essentials.intro }} per user a month on a <a href="/support-plans/">support plan</a>.
          {% else %}
            Our rate is £{{ site.hourlyRate }} an hour {{ site.vatIncLabel }}, and if we can't fix it you don't pay.
          {% endif %}
        </p>
      </div>

      <nav class="sibling-nav" aria-label="Related services">
        <h2>Other {{ "business" if service.group == "business" else "personal" }} services</h2>
        <ul>
          {% for s in services %}
            {% if s.group == service.group and s.slug != service.slug %}
            <li><a href="/{{ s.slug }}/">{{ s.title }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
        <p>
          <a href="{{ '/business-it/' if service.group == 'business' else '/personal-it/' }}">
            Back to {{ "Business IT" if service.group == "business" else "Personal IT" }}
          </a>
        </p>
      </nav>
    </div>
  </div>
</section>
