---
layout: layouts/base.njk
title: Book an appointment
heading: Book an appointment
standfirst: Pick a time that suits you. You will get a confirmation straight away.
description: Book a remote support session or a home or business visit with IT Surgery, covering Penarth, Barry and Cardiff. Instant confirmation.
---

{# The calendar comes first. It is what people arrived for, and everything that
   was above it repeated the standfirst or explained the fee — which the calendar
   itself already states. The explanation still follows, just underneath.

   The calendar is Cal.com, embedded with its own script so the frame sizes
   itself to its content. A fixed-height iframe was tried first and is worse:
   too short puts a scrollbar inside a scrolling page — the thing older users
   find hardest — and too tall leaves a dead gap under the calendar.

   The fallback below is NOT optional. The embed needs JavaScript, and if it is
   blocked or the script fails, nothing renders at all. Without a way out the
   customer cannot book and will not tell us why. #}
<section class="section booking-embed-section">
  <div class="container narrow">
    <p class="lead fee-notice">
      <strong>There is a £{{ site.bookingFee }} booking fee</strong> to confirm your
      slot. It comes off your first hour, and you get it back in full if we
      can't fix the problem.
    </p>

    {# Native details/summary: keyboard and screen-reader accessible with no
       JavaScript, and it still opens if scripting fails. The reasoning matters
       to the few people who want it and is clutter for everyone else, so it is
       one line until asked for. #}
    <details class="disclosure">
      <summary>Why we ask for a booking fee</summary>
      <p>
        Holding a slot means turning someone else away, and driving to a job
        that isn't there costs us the afternoon. The £{{ site.bookingFee }} is a
        small check that a booking is real — it is not meant to cover our time,
        just to make sure someone is expecting us.
      </p>
      <p>
        <strong>We never see your card details.</strong> Your invoice comes from
        Xero, our accounting system, and the payment itself is handled by
        Stripe. Nothing is stored by us. Our
        <a href="/booking-terms/">booking terms</a> set out the details.
      </p>
    </details>
  </div>

  <div class="container wide">
    {# Which service? The catalogue is rendered into the page as a slug
       allow-list, and ?service= is honoured only if it is on the list. Never
       feed a query parameter to the embed unvalidated — that would let any
       link put any calendar on our page. #}
    <p class="lead" id="service-name" hidden></p>
    <div class="booking-embed" id="my-cal-inline-remote-support-session"></div>

    <noscript>
      <p class="booking-fallback">
        The calendar needs JavaScript to load.
        <a href="{{ site.bookingUrl }}" target="_blank" rel="noopener">Open the booking page in a new tab<span class="visually-hidden"> (opens in a new tab)</span></a>,
        or <a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">message us on WhatsApp<span class="visually-hidden"> (opens in a new tab)</span></a>
        and we will book it for you.
      </p>
    </noscript>

    <p class="booking-fallback">
      Calendar not loading?
      <a href="{{ site.bookingUrl }}" target="_blank" rel="noopener">Open the booking page in a new tab<span class="visually-hidden"> (opens in a new tab)</span></a>,
      or just
      <a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">message us on WhatsApp<span class="visually-hidden"> (opens in a new tab)</span></a>
      and we will book it for you.
    </p>

    <script type="text/javascript">
      (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
      var BOOKABLE = {{ bookableslugs | dump | safe }};
      var BOOKABLE_NAMES = {{ bookablenames | dump | safe }};
      var service = new URLSearchParams(window.location.search).get("service");
      if (!service || BOOKABLE.indexOf(service) === -1) { service = "remote-support-session"; }
      if (service !== "remote-support-session") {
        var sn = document.getElementById("service-name");
        sn.textContent = "Booking: " + (BOOKABLE_NAMES[service] || service);
        sn.hidden = false;
      }
      Cal("init", "remote-support-session", {origin:"https://app.cal.com"});
      Cal.config = Cal.config || {};
      Cal.config.forwardQueryParams = true;
      Cal.ns["remote-support-session"]("inline", {
        elementOrSelector:"#my-cal-inline-remote-support-session",
        config: {"layout":"month_view","useSlotsViewOnSmallScreen":"true","theme":"auto"},
        calLink: "it-surgery/" + service,
      });
      Cal.ns["remote-support-session"]("ui", {"cssVarsPerTheme":{"light":{"cal-brand":"#990000"},"dark":{"cal-brand":"#ffffff"}},"hideEventTypeDetails":false,"layout":"month_view"});

      /* Cal.com's own "redirect on booking" is a paid feature, but the embed
         runs on this page, so we can do it ourselves for nothing.

         The payload shape is not guaranteed across embed versions, so dig for
         the booking id rather than trusting one path, and if we cannot find it
         just leave the customer on Cal.com's own confirmation — a worse page,
         but never a broken one. */
      Cal.ns["remote-support-session"]("on", {
        action: "bookingSuccessful",
        callback: function (e) {
          try {
            var d = (e && e.detail && e.detail.data) || (e && e.data) || {};
            var b = d.booking || d;
            var uid = b.uid || b.bookingUid || d.uid;
            var start = b.startTime || b.date || d.startTime;
            if (!uid) { return; }
            var to = "/booked/?uid=" + encodeURIComponent(uid);
            if (start) { to += "&t=" + encodeURIComponent(start); }
            window.location.href = to;
          } catch (err) { /* leave them on the Cal.com confirmation */ }
        }
      });
    </script>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <div class="cta-panel">
      <h2>Would rather talk to someone first?</h2>
      <p>
        <a href="https://wa.me/{{ site.whatsapp }}?text=Hello%2C%20I%27d%20like%20some%20help%20with%20an%20IT%20problem" target="_blank" rel="noopener">Message us on WhatsApp<span class="visually-hidden"> (opens in a new tab)</span></a>,
        <a href="tel:{{ site.phoneLink }}">call {{ site.phoneDisplay }}</a>,
        or <a href="/quote/">ask us to call you back</a>.
      </p>
    </div>
  </div>
</section>
