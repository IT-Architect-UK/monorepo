<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {# seoTitle lets a page set the whole search-result title. The default
     pattern is "Page | IT Surgery — Curing IT Headaches", whose 33-char
     suffix pushes some pages past the ~60 chars Google shows. #}
  <title>{% if seoTitle %}{{ seoTitle }}{% else %}{{ title }} | {{ site.name }} — {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description }}" />
  <meta name="theme-color" content="#990000" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  {# Thin or placeholder pages set noindex: true in front matter. A page with
     little content still competes for the same local search terms as the pages
     that matter, so it stays out of the index until it earns its place. #}
  {% if noindex %}<meta name="robots" content="noindex, follow" />{% endif %}

  {# Share cards. Without these a link pasted into WhatsApp, Facebook, LinkedIn
     or Messenger shows as a bare URL. og:title is the short page name; the
     apps show og:site_name beside it, so the long title pattern would repeat
     "IT Surgery" twice on the card. One image for every page, rebuilt by
     tools/build-og-image.js; the ?v= hash makes a replaced image show at once
     rather than after the platform's cache expires. #}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.url }}{{ '/assets/og-image.png' | v }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="{{ site.name }} — {{ site.tagline }}. Friendly IT help for homes and small businesses in {{ site.areas | join(', ') }}, and remote support UK-wide." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }}" />
  <meta name="twitter:description" content="{{ description }}" />
  <meta name="twitter:image" content="{{ site.url }}{{ '/assets/og-image.png' | v }}" />

  {# Theme must be resolved BEFORE first paint. Inline and blocking on purpose:
     from an external file this runs after the stylesheet has already painted,
     and a dark-mode visitor gets a white flash on every navigation. #}
  <script>
    (function () {
      try {
        /* An explicit choice always wins. Otherwise follow the operating system.
           matchMedia returns false when the OS expresses no preference, so light
           is the fallback without needing a special case for it. */
        var saved = localStorage.getItem("theme");
        var dark = saved
          ? saved === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (dark) document.documentElement.setAttribute("data-theme", "dark");
      } catch (e) {
        /* Storage blocked (private mode). Light is a safe fallback. */
      }
    })();
  </script>

  {# Favicons. icon.svg is the same cross path as the header logo, so the tab
     icon and the brand mark are one shape. The .ico (16/32/48) covers older
     browsers. apple-touch-icon must be opaque — iOS composites transparency
     onto black, which is the exact thing we are avoiding here. #}
  <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  {# Poppins is self-hosted (see @font-face in styles.css). Preloading the
     600 weight, which every heading and menu item uses, lets it download in
     parallel with the stylesheet instead of after it. crossorigin is required
     on font preloads even for same-origin files, or the browser fetches twice. #}
  <link rel="preload" href="/assets/fonts/poppins-v24-latin-600.woff2" as="font" type="font/woff2" crossorigin />

  {# Structured data for search engines. @id gives the business one stable
     identity across every page; image/logo feed the knowledge panel; sameAs
     ties this site to the Google Business Profile and social pages so Google
     treats them as one business. Opening hours are deliberately absent: work
     is by appointment, and schema.org has no honest way to say that - a made-up
     09:00-17:00 would show "Closed" in search results outside those hours. #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "{{ site.url }}/#business",
    "name": "{{ site.name }}",
    "slogan": "{{ site.tagline }}",
    "description": "Friendly, plain-English IT help for homes and small businesses in {{ site.areas | join(', ') }}, with remote support across the UK. Fixed prices, no fix no fee.",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}/assets/logo@3x.png",
    "image": "{{ site.url }}{{ '/assets/og-image.png' | v }}",
    "telephone": "{{ site.phoneLink }}",
    "email": "{{ site.email }}",
    "legalName": "{{ site.legalName }}",
    "vatID": "GB{{ site.vatNumber | replace(' ', '') }}",
    "priceRange": "££",
    "currenciesAccepted": "GBP",
    "paymentAccepted": "Card, Bank transfer",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.address.street }}",
      "addressLocality": "{{ site.address.locality }}",
      "addressRegion": "{{ site.address.town }}",
      "postalCode": "{{ site.address.postcode }}",
      "addressCountry": "GB"
    },
    "areaServed": [
      {% for a in site.areas %}{ "@type": "City", "name": "{{ a }}" },
      {% endfor %}{ "@type": "Country", "name": "United Kingdom", "description": "Remote support" }
    ],
    "sameAs": {{ site.sameAs | dump | safe }}
  }
  </script>
  {# Fixed-price pages also publish their catalogue as an OfferCatalog so the
     prices are machine-readable. Rendered from catalogue.json, so it can never
     disagree with the list on the page. #}
  {% if offerAudience %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    "name": "{{ title }} — {{ site.name }}",
    "url": "{{ site.url }}{{ page.url }}",
    "itemListElement": [
      {% set first = true %}{% for c in catalogue.services %}{% if c.audience == offerAudience and c.bookable and not c.existing %}{% if not first %},{% endif %}{% set first = false %}
      {
        "@type": "Offer",
        "itemOffered": { "@type": "Service", "name": {{ c.name | dump | safe }}, "provider": { "@id": "{{ site.url }}/#business" } },
        "url": "{{ site.url }}/book/?service={{ c.slug }}",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "{{ c.priceIncVat or c.priceExVat }}",
          "priceCurrency": "GBP",
          "valueAddedTaxIncluded": {{ "true" if c.priceIncVat else "false" }}
        }
      }{% endif %}{% endfor %}
    ]
  }
  </script>
  {% endif %}

  {# ?v= is a content hash — see the cache-busting note in eleventy.config.cjs #}
  <link rel="stylesheet" href="{{ '/assets/fonts.css' | v }}" />
  <link rel="stylesheet" href="/assets/styles.css?v={{ assetHash }}" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>

  {% include "partials/header.njk" %}

  <main id="main">
    {% if not hidePageTitle %}
    <div class="page-head">
      <div class="container">
        <h1>{{ heading or title }}</h1>
        {% if standfirst %}<p class="standfirst">{{ standfirst }}</p>{% endif %}
      </div>
    </div>
    {% endif %}

    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script>
    // Mobile menu toggle. Progressive enhancement: without JS the nav is
    // simply always visible, so nothing becomes unreachable.
    (function () {
      var btn = document.querySelector('.menu-toggle');
      var nav = document.getElementById('main-nav');
      if (!btn || !nav) return;
      btn.hidden = false;
      nav.classList.add('is-collapsible');
      btn.addEventListener('click', function () {
        var open = nav.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.querySelector('.menu-toggle-text').textContent = open ? 'Close' : 'Menu';
      });
      // Dropdowns: click to open on touch devices, hover handled in CSS.
      // Behaves as an accordion so the mobile menu stays short.
      var toggles = nav.querySelectorAll('.has-children > .dropdown-toggle');
      toggles.forEach(function (t) {
        t.addEventListener('click', function (e) {
          e.preventDefault();
          var li = t.parentElement;
          var willOpen = !li.classList.contains('open');
          toggles.forEach(function (other) {
            other.parentElement.classList.remove('open');
            other.setAttribute('aria-expanded', 'false');
          });
          if (willOpen) {
            li.classList.add('open');
            t.setAttribute('aria-expanded', 'true');
          }
        });
      });
    })();

    // Theme toggle. Revealed only with JS — a control that cannot work should
    // not be shown at all.
    (function () {
      var btn = document.querySelector('.theme-toggle');
      if (!btn) return;
      var root = document.documentElement;
      var meta = document.querySelector('meta[name="theme-color"]');
      var LIGHT = '#990000', DARK = '#12161c';

      function sync() {
        var dark = root.getAttribute('data-theme') === 'dark';
        btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
        if (meta) meta.setAttribute('content', dark ? DARK : LIGHT);
      }

      btn.hidden = false;
      sync();

      btn.addEventListener('click', function () {
        var dark = root.getAttribute('data-theme') === 'dark';
        if (dark) root.removeAttribute('data-theme');
        else root.setAttribute('data-theme', 'dark');
        try { localStorage.setItem('theme', dark ? 'light' : 'dark'); } catch (e) {}
        sync();
      });

      // Follow the OS live, but only while the visitor has made no explicit
      // choice of their own.
      try {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
          if (localStorage.getItem('theme')) return;
          if (e.matches) root.setAttribute('data-theme', 'dark');
          else root.removeAttribute('data-theme');
          sync();
        });
      } catch (e) {}
    })();
  </script>
</body>
</html>
