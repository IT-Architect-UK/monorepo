<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} | {{ site.name }} — {{ site.tagline }}</title>
  <meta name="description" content="{{ description }}" />
  <meta name="theme-color" content="#990000" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

  {# Favicons. icon.svg is the same cross path as the header logo, so the tab
     icon and the brand mark are one shape. The .ico (16/32/48) covers older
     browsers. apple-touch-icon must be opaque — iOS composites transparency
     onto black, which is the exact thing we are avoiding here. #}
  <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&display=swap" rel="stylesheet" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "{{ site.name }}",
    "slogan": "{{ site.tagline }}",
    "url": "{{ site.url }}",
    "telephone": "{{ site.phoneLink }}",
    "email": "{{ site.email }}",
    "legalName": "{{ site.legalName }}",
    "priceRange": "£{{ site.hourlyRate }} per hour",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.address.street }}",
      "addressLocality": "{{ site.address.locality }}",
      "addressRegion": "{{ site.address.town }}",
      "postalCode": "{{ site.address.postcode }}",
      "addressCountry": "GB"
    },
    "areaServed": [{% for a in site.areas %}"{{ a }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  }
  </script>

  {# ?v= is a content hash — see the cache-busting note in eleventy.config.cjs #}
  <link rel="stylesheet" href="/assets/styles.css?v={{ assetHash }}" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>

  {% include "partials/header.njk" %}

  <main id="main">
    {% if not hidePageTitle %}
    <div class="page-head">
      <div class="container">
        <h1>{{ heading or title }}</h1>
        {% if standfirst %}<p class="standfirst">{{ standfirst }}</p>{% endif %}
      </div>
    </div>
    {% endif %}

    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script>
    // Mobile menu toggle. Progressive enhancement: without JS the nav is
    // simply always visible, so nothing becomes unreachable.
    (function () {
      var btn = document.querySelector('.menu-toggle');
      var nav = document.getElementById('main-nav');
      if (!btn || !nav) return;
      btn.hidden = false;
      nav.classList.add('is-collapsible');
      btn.addEventListener('click', function () {
        var open = nav.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.querySelector('.menu-toggle-text').textContent = open ? 'Close' : 'Menu';
      });
      // Dropdowns: click to open on touch devices, hover handled in CSS.
      // Behaves as an accordion so the mobile menu stays short.
      var toggles = nav.querySelectorAll('.has-children > .dropdown-toggle');
      toggles.forEach(function (t) {
        t.addEventListener('click', function (e) {
          e.preventDefault();
          var li = t.parentElement;
          var willOpen = !li.classList.contains('open');
          toggles.forEach(function (other) {
            other.parentElement.classList.remove('open');
            other.setAttribute('aria-expanded', 'false');
          });
          if (willOpen) {
            li.classList.add('open');
            t.setAttribute('aria-expanded', 'true');
          }
        });
      });
    })();
  </script>
</body>
</html>
