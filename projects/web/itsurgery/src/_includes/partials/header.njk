{# Utility bar: About Us and the theme toggle on the left, the three contact
   actions on the right. The toggle sits apart from the contact buttons on
   purpose — it looks different because it does a different kind of thing, and
   grouping it with them made it read as a fourth broken button.
   Get a Quote sits where the phone number used to, because that slot is the one
   people look at first and the form is now the channel we want them to use.
   "Quote Request" was removed from the left nav — it pointed at the same page,
   and two differently-worded links to one destination is a reason to hesitate. #}
<div class="utility-bar">
  <div class="container utility-inner">
    <div class="utility-left">
      <nav class="utility-links" aria-label="Secondary">
        {% for item in site.utilityNav %}
        <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.text }}</a>
        {% endfor %}
      </nav>
      {# aria-pressed carries the state, so the accessible name stays constant
           ("Dark mode") instead of flipping between two labels. #}
        <button class="theme-toggle" type="button" aria-pressed="false" hidden>
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4.5" />
            <g stroke-width="2" stroke-linecap="round">
              <path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M19.8 4.2l-2.1 2.1M6.3 17.7l-2.1 2.1" />
            </g>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20.5 14.5A8.6 8.6 0 0 1 9.5 3.5a8.7 8.7 0 1 0 11 11z" />
          </svg>
          <span class="visually-hidden">Dark mode</span>
        </button>
    </div>
    <nav class="utility-contact" aria-label="Contact us">
      <a class="ubtn" href="/book/"{% if page.url == "/book/" %} aria-current="page"{% endif %}>Book</a>
      <a class="ubtn" href="/quote/"{% if page.url == "/quote/" %} aria-current="page"{% endif %}>Get a Quote</a>
      <a class="ubtn" href="https://wa.me/{{ site.whatsapp }}?text=Hello%2C%20I%27d%20like%20some%20help%20with%20an%20IT%20problem" target="_blank" rel="noopener">WhatsApp<span class="visually-hidden"> (opens in a new tab)</span></a>
    </nav>
  </div>
</div>

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="{{ site.name }} — home">
      {# One file per theme. The wordmark is near-black, so on the dark page it
         would vanish; the dark file is white-to-grey. Both are the same pixel
         size, so the header does not shift when the theme changes. alt="" is
         correct here — the link already carries an aria-label, so alt text
         would make screen readers announce the name twice.

         Rebuilt from the Illustrator master by tools/build-logo.py — see LOGO.md
         for what was tried and rejected before this. Two things matter and are
         easy to undo by accident:

         1. srcset with density descriptors. The old asset was 1106px wide painted
            at 177px, so every visitor saw a 6x browser downscale, and that
            resampling was most of the "blurred" look. Each display now gets an
            asset at its own density and never upscales.
         2. The 1x file is 179px wide. The paint area was 177px when it was made
            and is now 143px (2.75rem tall, see .brand img in styles.css), so a
            1x display downscales it slightly. Never go the other way: upscaling
            a bitmap reintroduces exactly the blur this change removes. If you
            regenerate these, keep 1x >= the painted size. #}
      <img class="logo-light" src="{{ '/assets/logo.png' | v }}" alt="" width="179" height="55"
           srcset="{{ '/assets/logo.png' | v }} 1x, {{ '/assets/logo@2x.png' | v }} 2x, {{ '/assets/logo@3x.png' | v }} 3x" />
      <img class="logo-dark" src="{{ '/assets/logo-dark.png' | v }}" alt="" width="179" height="55"
           srcset="{{ '/assets/logo-dark.png' | v }} 1x, {{ '/assets/logo-dark@2x.png' | v }} 2x, {{ '/assets/logo-dark@3x.png' | v }} 3x" />
      {# Tagline sits BESIDE the logo, on its centre line. Placed underneath it
         fought the stethoscope, which is itself a horizontal underline, and read
         as a caption. Kept as live text rather than drawn into the image so it
         reflows on mobile, stays selectable and search engines can read it. #}
      <span class="brand-tag">{{ site.tagline }}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" hidden>
      <span class="menu-toggle-text">Menu</span>
    </button>

    <nav class="main-nav" id="main-nav" aria-label="Main">
      <ul>
        {% for item in site.nav %}
          {% if item.group %}
          <li class="has-children">
            <a class="dropdown-toggle" href="{{ item.url }}" aria-expanded="false"{% if page.url == item.url %} aria-current="page"{% endif %}>
              {{ item.text }} <span class="caret" aria-hidden="true">▾</span>
            </a>
            <ul class="submenu">
              <li><a href="{{ item.url }}">{{ item.text }} overview</a></li>
              {% for s in services %}
                {% if s.group == item.group %}
                <li><a href="/{{ s.slug }}/"{% if page.url == "/" + s.slug + "/" %} aria-current="page"{% endif %}>{{ s.title }}</a></li>
                {% endif %}
              {% endfor %}
            </ul>
          </li>
          {% else %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.text }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
