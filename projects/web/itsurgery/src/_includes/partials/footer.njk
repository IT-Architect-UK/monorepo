<footer class="site-footer">
  <div class="container footer-grid">

    <div class="footer-col">
      <p class="footer-brand">{{ site.name }}</p>
      <p class="footer-tag">{{ site.tagline }}</p>
      <p class="footer-small">
        Friendly IT help for homes and small businesses in
        {{ site.areas | join(", ") }}.
      </p>
    </div>



    {# Contact methods only. Page links live in the bar below so this column
       does what its heading says. #}
    <div class="footer-col">
      <h2>Get in touch</h2>
      <ul class="footer-contact">
        <li><a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">WhatsApp us<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li><a href="/quote/">Request a quote or callback</a></li>
      </ul>
      {# Passive on purpose. Nobody is asked for a review here — this is for a
         customer who already decided to leave one and is looking for where. The
         asking happens after a job, not on a web page. #}
      <p class="footer-small footer-review">
        Been a customer?
        <a href="{{ site.reviewUrl }}" target="_blank" rel="noopener">Leave us a Google review<span class="visually-hidden"> (opens in a new tab)</span></a>.
      </p>
    </div>

  </div>

  <nav class="container footer-links" aria-label="More pages">
    <a href="/pricing/">Hourly Rates</a>
    <a href="/support-plans/">Support Plans</a>
    <a href="/remote-support/">Remote Support</a>
    <a href="/about-us/">About Us</a>
    <a href="/faq/">FAQs</a>
    <a href="/booking-terms/">Booking Terms</a> <a href="/plan-terms/">Plan Terms</a>
    <a href="/privacy/">Privacy Policy</a>
    <a href="/privacy/#cookies" data-consent="settings" hidden>Cookie settings</a>
    <a href="/report-a-problem/">Report a website problem</a>
  </nav>

  <div class="container footer-legal">
    {# Companies Act 2006 trading disclosures: registered name, number and place
       of registration shown here; the registered office address is published on
       the About Us page, which satisfies the same requirement. #}
    <p>
      &copy; {% year %} {{ site.name }} — a trading name of {{ site.legalName }},
      a company registered in {{ site.placeOfRegistration }}.
    </p>
    <p>
      Company Number: {{ site.companyNumber }}
      | VAT Registration Number: {{ site.vatNumber }}
    </p>
  </div>
</footer>
