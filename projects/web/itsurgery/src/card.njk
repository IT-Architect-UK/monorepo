---
layout: layouts/card.njk
title: Business card
permalink: /card/
eleventyExcludeFromCollections: true
---
{# Two 85x55mm pages, front then back — exactly what a printer asks for. #}

<div class="card card-front">
  <div class="brand">
    <img src="/assets/logo@3x.png" alt="{{ site.name }}" />
    <p class="strap">{{ site.tagline }}</p>
  </div>

  {# A description list, because that is what this is: labels and values.
     The grid gives every value the same left edge. #}
  <dl class="details">
    <dt>Name</dt>     <dd class="name">Darren Pilkington</dd>
    <dt>Role</dt>     <dd>IT Engineer</dd>
    <dt>Email</dt>    <dd>{{ site.email | lower }}</dd>
    <dt>Phone</dt>    <dd>{{ site.phoneDisplay }}</dd>
    <dt>WhatsApp</dt> <dd class="web">@itsurgery</dd>
    <dt>Website</dt>  <dd class="web">{{ site.url | replace("https://", "") }}</dd>
  </dl>
</div>

<div class="card card-back">
  <h2>Got an IT requirement?<br />We have the solution!</h2>
  <p class="what">
    Computers · Networks · Cloud · Wi-Fi · AI · IoT · Smart Home · Software · Web Design · Microsoft 365 · Mobile &amp; End User Compute
  </p>
  <p class="what where">
    For homes &amp; businesses across Penarth, Barry, Cardiff &amp; Online.
  </p>
  <p class="promises">
    <span>Fixed prices</span>
    <span>No fix, no fee</span>
    <span>Plain English, always</span>
  </p>
</div>
