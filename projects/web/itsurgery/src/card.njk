---
layout: layouts/card.njk
title: Business card
permalink: /card/
eleventyExcludeFromCollections: true
---
{# Two 85x55mm pages, front then back — exactly what a printer asks for. #}

<div class="card card-front">
  <div class="front-left">
    <img src="/assets/logo@3x.png" alt="{{ site.name }}" />
    <p class="strap">{{ site.tagline }}</p>
  </div>

  <div class="front-right">
    <p class="name">Darren Pilkington</p>
    <p>IT engineer</p>
    <p>{{ site.phoneDisplay }} — call or WhatsApp</p>
    <p>{{ site.email }}</p>
    <p class="web">{{ site.url | replace("https://", "") }}</p>
  </div>
</div>

<div class="card card-back">
  <h2>Whatever your IT problem,<br />we'll sort it</h2>
  <p class="what">
    Computers, phones, Wi-Fi, printers and email — for homes and small
    businesses across {{ site.areas | join(", ") }}.
  </p>
  <p class="promises">
    <span>Fixed prices</span>
    <span>No fix, no fee</span>
    <span>Since 2008</span>
  </p>
</div>
