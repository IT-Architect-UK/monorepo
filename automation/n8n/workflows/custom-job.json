        "specifyBody": "json",
        "jsonBody": "={}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [200, -120],
      "id": "email-invoice",
      "name": "Send it to them",
      "credentials": { "xeroOAuth2Api": { "id": "DCxryEtuSrcWPmFu", "name": "Xero — IT Solution Architecture Ltd" } },
      "notes": "Xero emails the invoice with a Pay Now button. The link is also shown on screen, for when it is easier to text it to somebody."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://crm.itsurgery.me/api/v1/Contact",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"firstName\": \"{{ $('Check it').item.json.firstName }}\", \"lastName\": \"{{ $('Check it').item.json.lastName }}\", \"emailAddress\": \"{{ $('Check it').item.json.email }}\", \"description\": \"Custom job: {{ $('Check it').item.json.work }}\"}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Skip-Duplicate-Check", "value": "true" }] }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [420, -120],
      "id": "add-to-crm",
      "name": "Add them to the CRM",
      "onError": "continueRegularOutput",
      "credentials": { "httpHeaderAuth": { "id": "sOse4EsI4Hy6KYi6", "name": "EspoCRM — crm.itsurgery.me" } },
      "notes": "Best effort. A CRM hiccup must not stop an invoice going out — the money matters more than the record, and the record can be fixed afterwards."
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Invoice raised</title><style>body{font:16px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f4f5f7;color:#333;margin:0;padding:1.5rem}.c{background:#fff;border:1px solid #dcdfe3;border-radius:10px;padding:1.5rem;max-width:34rem;margin:0 auto}h1{font-size:1.1rem;margin:0 0 .75rem}a{color:#990000}code{display:block;background:#f4f5f7;border:1px solid #dcdfe3;border-radius:6px;padding:.6rem;font-size:.8rem;word-break:break-all;margin:.6rem 0}</style></head><body><div class=\"c\"><h1>Invoice {{ $('Raise the invoice').item.json.Invoices[0].InvoiceNumber }} raised</h1><p>{{ $('Check it').item.json.name }} has been emailed the invoice for £{{ $('Raise the invoice').item.json.Invoices[0].Total }}, with a Pay Now button.</p><p>If it is easier to text or WhatsApp them the link:</p><code>{{ $('Get the pay link').item.json.OnlineInvoices[0].OnlineInvoiceUrl }}</code><p><a href=\"/webhook/dashboard\">Back to the dashboard</a></p></div></body></html>",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Content-Type", "value": "text/html; charset=utf-8" },
              { "name": "Cache-Control", "value": "no-store" }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [640, -120],
      "id": "confirm",
      "name": "Show the link"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Not sent</title><style>body{font:16px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f4f5f7;color:#333;margin:0;padding:1.5rem}.c{background:#fff;border:1px solid #dcdfe3;border-radius:10px;padding:1.5rem;max-width:30rem;margin:0 auto}h1{font-size:1.1rem;margin:0 0 .75rem;color:#990000}a{color:#990000}</style></head><body><div class=\"c\"><h1>Nothing was raised</h1><p>The form needs {{ $json.problems.join(', and ') }}.</p><p><a href=\"/webhook/dashboard\">Go back and try again</a></p></div></body></html>",
        "options": {
