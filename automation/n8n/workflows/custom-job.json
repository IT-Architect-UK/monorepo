{
  "name": "Custom job",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "custom-job",
        "authentication": "basicAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-900, 0],
      "id": "custom-job-webhook",
      "name": "New job",
      "webhookId": "8f3c1d27-64ba-4e19-a0d5-2b7e9f41c063",
      "credentials": { "httpBasicAuth": { "id": "Hi3G6E9Nx9HDAY2D", "name": "Dashboard login" } },
      "notes": "Behind the dashboard login. This raises real invoices, so it is not something to leave open."
    },
    {
      "parameters": {
        "jsCode": "// Everything here was typed into a form by hand, quite possibly on a phone\n// between jobs. Check it before it becomes an invoice.\n\nconst b = $input.first().json.body || {};\nconst name = String(b.customer || '').trim();\nconst email = String(b.email || '').trim();\nconst work = String(b.work || '').trim();\nconst amount = Number(String(b.amount || '').replace(/[£,\\s]/g, ''));\nconst business = String(b.vat || '') === 'business';\n\nconst problems = [];\nif (name.length < 2) problems.push('a customer name');\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) problems.push('a valid email address');\nif (work.length < 3) problems.push('a description of the work');\nif (!isFinite(amount) || amount <= 0) problems.push('an amount greater than zero');\nif (amount > 5000) problems.push('an amount under £5000 (raise anything larger in Xero directly)');\n\n// Split a typed name into the two fields the CRM wants, without pretending to\n// be clever about it.\nconst bits = name.split(/\\s+/);\nconst firstName = bits.length > 1 ? bits.slice(0, -1).join(' ') : name;\nconst lastName = bits.length > 1 ? bits[bits.length - 1] : '';\n\nreturn [{ json: { ok: problems.length === 0, problems, name, firstName, lastName,\n  email, work, amount: Math.round(amount * 100) / 100, business } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-680, 0],
      "id": "check-it",
      "name": "Check it"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [{
            "id": "is-valid",
            "leftValue": "={{ $json.ok }}",
            "rightValue": "",
            "operator": { "type": "boolean", "operation": "true", "singleValue": true }
          }],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [-460, 0],
      "id": "is-it-valid",
      "name": "Is it valid?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.xero.com/api.xro/2.0/Invoices",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "xeroOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "xero-tenant-id", "value": "a758211a-256c-4b52-a2b6-b8c7568c2cb8" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"Type\": \"ACCREC\", \"Contact\": {\"Name\": \"{{ $json.name }}\", \"FirstName\": \"{{ $json.firstName }}\", \"LastName\": \"{{ $json.lastName }}\", \"EmailAddress\": \"{{ $json.email }}\"}, \"Date\": \"{{ $now.setZone('Europe/London').toFormat('yyyy-MM-dd') }}\", \"DueDate\": \"{{ $now.setZone('Europe/London').toFormat('yyyy-MM-dd') }}\", \"Reference\": \"Agreed with customer\", \"LineAmountTypes\": \"{{ $json.business ? 'Exclusive' : 'Inclusive' }}\", \"Status\": \"AUTHORISED\", \"LineItems\": [{\"Description\": \"{{ $json.work }}\", \"Quantity\": 1, \"UnitAmount\": {{ $json.amount }}, \"AccountCode\": \"200\", \"TaxType\": \"OUTPUT2\"}]}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [-240, -120],
      "id": "raise-invoice",
      "name": "Raise the invoice",
      "credentials": { "xeroOAuth2Api": { "id": "DCxryEtuSrcWPmFu", "name": "Xero — IT Solution Architecture Ltd" } },
      "notes": "Inclusive for home customers, Exclusive for business — the same distinction the website makes, because £60 + VAT and £60 inc VAT are different jobs' worth of money."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.xero.com/api.xro/2.0/Invoices/{{ $json.Invoices[0].InvoiceID }}/OnlineInvoice",
        "authentication": "predefinedCredentialType",
