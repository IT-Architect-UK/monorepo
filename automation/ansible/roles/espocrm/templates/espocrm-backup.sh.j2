#!/usr/bin/env bash
# {{ ansible_managed }}
#
# espocrm-backup.sh — produce restorable EspoCRM backup artefacts.
#
# Why a dump rather than backing up the raw files: MariaDB's data
# files are written continuously, so a file-level copy of a running database
# is a torn snapshot that may not restore. mysqldump gives a consistent point
# in time. The off-box backup then takes THIS directory, not the live volumes.
#
# Usage:
#   /usr/local/bin/espocrm-backup.sh
# Runs unattended from espocrm-backup.timer; safe to run by hand at any time.

set -euo pipefail

BACKUP_DIR="{{ espocrm_backup_dir }}"
KEEP_DAYS={{ espocrm_local_backup_keep_days }}
STAMP="$(date +%Y%m%d-%H%M%S)"

mkdir -p "$BACKUP_DIR"

# --- database -------------------------------------------------------------
# --single-transaction keeps InnoDB consistent without locking the whole DB,
# so the CRM stays usable while the dump runs.
#
# The password goes via MYSQL_PWD, NOT --password=. A password on the command
# line is visible in `ps aux` to every user on the host for the whole duration
# of the dump. Passing the variable name alone to `docker exec -e` forwards the
# value from this script's environment without it appearing in any argv.
#
# Single-quoted on assignment so the shell does not expand $, ` or \ in the
# password. Only a literal single quote would break this, and the role rejects
# those - see the assert in tasks/main.yml.
export MYSQL_PWD='{{ espocrm_db_root_password }}'

docker exec -e MYSQL_PWD espocrm-db mariadb-dump \
    --single-transaction \
    --quick \
    --user=root \
    "{{ espocrm_db_name }}" \
  | gzip -9 > "${BACKUP_DIR}/espocrm-db-${STAMP}.sql.gz"

unset MYSQL_PWD

# --- application files ----------------------------------------------------
# data/ holds uploaded attachments and the generated config; custom/ holds any
# customisation made through the admin UI. Everything else comes from the image.
docker run --rm \
    -v espocrm_espocrm:/src:ro \
    -v "${BACKUP_DIR}":/dest \
    alpine:3 \
    tar czf "/dest/espocrm-files-${STAMP}.tar.gz" -C /src data custom

# --- prune local copies ---------------------------------------------------
# The off-box backup holds the long-term history; this is only a staging area.
find "$BACKUP_DIR" -name 'espocrm-*' -type f -mtime "+${KEEP_DAYS}" -delete

echo "espocrm backup complete: ${STAMP}"
