# {{ ansible_managed }}
# Reverse proxy for MeshCentral.
#
# Same two-pass approach as the espocrm and n8n sites: Ansible owns this file,
# certbot runs with "certonly --webroot" and never edits it, and the TLS block
# only appears once the certificate exists so the first run can answer the
# ACME HTTP-01 challenge over plain HTTP.

server {
    listen 80;
{% if meshcentral_enable_ipv6 %}
    listen [::]:80;
{% endif %}
    server_name {{ meshcentral_domain }};

    location /.well-known/acme-challenge/ {
        root {{ meshcentral_acme_webroot }};
    }

{% if meshcentral_tls_ready %}
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
    location / {
        proxy_pass http://127.0.0.1:{{ meshcentral_http_port }};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{% endif %}
}

{% if meshcentral_tls_ready %}
server {
    # "listen ... http2" rather than "http2 on;" — the latter needs nginx
    # 1.25.1+ and Ubuntu 24.04 ships 1.24.
    listen 443 ssl http2;
{% if meshcentral_enable_ipv6 %}
    listen [::]:443 ssl http2;
{% endif %}
    server_name {{ meshcentral_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ meshcentral_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ meshcentral_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # The assistant executable is served from here.
    client_max_body_size 64m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:{{ meshcentral_http_port }};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Agents and the control session are websockets held open for the life
        # of the connection. Without the upgrade headers the console loads and
        # then sits there showing nothing.
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Longer than MeshCentral's 300s agent keepalive, so the proxy never
        # cuts a connection the application still believes is healthy. The
        # default 60s would drop every idle agent once a minute.
        proxy_read_timeout 330s;
        proxy_send_timeout 330s;

        # Buffering a live remote-control stream adds latency to every click.
        proxy_buffering off;
    }
}
{% endif %}
