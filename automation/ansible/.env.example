# =============================================================================
# Ansible — site values for CLI runs (copy to .env, then: source .env)
# =============================================================================
# On the toolbox these come from Semaphore's "Proxmox" variable group and this
# file is not needed. .env is git-ignored — private network detail stays local.

# Trusted subnet(s): the common role opens every port to these CIDRs on the
# servers it builds. Comma-separated. Empty/unset = SSH + ICMP baseline only.
export TRUSTED_SUBNETS="192.168.4.0/24"
