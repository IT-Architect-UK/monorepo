# =============================================================================
# setup-iptables.sh — site values (copy to .env; .env is git-ignored)
# =============================================================================
# Trusted subnet(s): every port and protocol is opened to these CIDRs on top of
# the SSH + ICMP baseline. Comma-separated. Private network detail — keep it
# here or in your shell, never in the repo.
export TRUSTED_SUBNETS="192.168.4.0/24"
